#!/usr/bin/env python3
"""Unified pipeline daemon -- single process, both models loaded, processes queue.

Loads EasyOCR + Parakeet TDT once. Checks a single queue table for pending
work. Processes up to MAX_BATCH screenshots or one audio file per cycle.
Runs as a systemd service, not a cron job.

Durability: SQLite-backed queue. Crash mid-job -> next cycle re-enqueues.
"""

import os, sys, json, time, sqlite3, signal, subprocess, threading
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path
from datetime import datetime, timezone

# asr_decoder / vad_chunker are imported lazily inside methods; keep bin on path.
sys.path.insert(0, os.path.expanduser("~/.local/bin"))

# --- Config ---
SCREENSHOTS_DIR = Path("/home/aoi/data/syncthing/oneplus15/Screenshots")
RECORDINGS_DIR = Path("/home/aoi/data/syncthing/oneplus15/Recordings")
SS_KB = Path.home() / "kino/data/screenshots"
REC_KB = Path.home() / "kino/data/recordings"
LOG_DIR = Path.home() / "kino/data/Log"
DB_PATH = Path.home() / ".local/share/pipeline_state.db"

SS_BATCH = 25
MAX_RUN_SEC = 580
POLL_INTERVAL = 30  # seconds between queue checks
HEALTH_PORT = int(os.environ.get("PIPELINE_HEALTH_PORT", "9355"))
# Limit ONNX threads to reduce memory
os.environ["OMP_NUM_THREADS"] = "2"
os.environ["MKL_NUM_THREADS"] = "2"
os.environ["OPENBLAS_NUM_THREADS"] = "2"

MODEL_DIR = Path.home() / ".local/share/com.mydatatimeline.timeline/models/parakeet-tdt-int8"


# --- SQLite queue ---
def init_queue():
    conn = sqlite3.connect(str(DB_PATH))
    conn.execute("PRAGMA journal_mode=WAL")
    conn.execute("""CREATE TABLE IF NOT EXISTS pipeline_queue (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        pipeline TEXT NOT NULL,
        file_name TEXT NOT NULL,
        status TEXT NOT NULL DEFAULT 'pending',
        error TEXT DEFAULT '',
        enqueued_at TEXT DEFAULT (datetime('now')),
        started_at TEXT,
        completed_at TEXT
    )""")
    conn.execute("CREATE INDEX IF NOT EXISTS idx_queue_pending ON pipeline_queue(pipeline, status)")
    conn.commit()
    conn.close()


def enqueue_pending(pipe_name, dir_path, extension):
    """Add files not yet in queue to the queue."""
    conn = sqlite3.connect(str(DB_PATH))
    queued = {
        r[0] for r in conn.execute(
            "SELECT file_name FROM pipeline_queue WHERE pipeline=?", (pipe_name,)
        ).fetchall()
    }
    for f in sorted(dir_path.glob(f"*{extension}"), key=lambda p: p.stat().st_mtime, reverse=True):
        if f.name not in queued:
            conn.execute(
                "INSERT INTO pipeline_queue (pipeline, file_name) VALUES (?, ?)",
                (pipe_name, f.name),
            )
    conn.commit()
    conn.close()


def pop_next(pipe_name):
    """Get next pending item, mark started. Returns row or None."""
    conn = sqlite3.connect(str(DB_PATH))
    try:
        row = conn.execute(
            "SELECT id, file_name FROM pipeline_queue "
            "WHERE pipeline=? AND status='pending' ORDER BY id DESC LIMIT 1",
            (pipe_name,),
        ).fetchone()
        if row:
            conn.execute(
                "UPDATE pipeline_queue SET status='running', started_at=datetime('now') WHERE id=?",
                (row[0],),
            )
            conn.commit()
            return row
        return None
    finally:
        conn.close()


def mark_done(qid, status="done", error=""):
    """Record a job's terminal status.

    Bookkeeping must never crash the processing loop: if the database is
    unreachable (locked, missing dir, disk full) we log and return. The job
    stays 'running' and is recovered by requeue_stale() on the next start.
    """
    try:
        conn = sqlite3.connect(str(DB_PATH))
        try:
            conn.execute(
                "UPDATE pipeline_queue SET status=?, error=?, completed_at=datetime('now') WHERE id=?",
                (status, error, qid),
            )
            conn.commit()
        finally:
            conn.close()
    except sqlite3.Error as e:
        sys.stderr.write(f"mark_done({qid}, {status}) failed: {e}\n")


def requeue_stale():
    """Reset rows stuck in 'running' back to 'pending'.

    A crash or SIGTERM can leave a job marked 'running'; without this it would
    never be popped again (enqueue_pending only skips files already in the
    queue, regardless of status). Called at startup. Returns rows reset.
    """
    try:
        conn = sqlite3.connect(str(DB_PATH))
        try:
            cur = conn.execute(
                "UPDATE pipeline_queue SET status='pending', started_at=NULL "
                "WHERE status='running'"
            )
            conn.commit()
            return cur.rowcount
        finally:
            conn.close()
    except sqlite3.Error as e:
        sys.stderr.write(f"requeue_stale failed: {e}\n")
        return 0


def get_pending_count(pipe_name):
    conn = sqlite3.connect(str(DB_PATH))
    c = conn.execute(
        "SELECT COUNT(*) FROM pipeline_queue WHERE pipeline=? AND status='pending'",
        (pipe_name,),
    ).fetchone()[0]
    conn.close()
    return c


# --- Health / watchdog ---
def build_health(daemon):
    """Return a JSON-serializable health snapshot for the daemon."""
    try:
        pending = {
            "screenshot-ocr": get_pending_count("screenshot-ocr"),
            "parakeet": get_pending_count("parakeet"),
        }
        db_ok = True
    except sqlite3.Error as e:
        pending = {}
        db_ok = False
        sys.stderr.write(f"build_health db error: {e}\n")
    now = time.time()
    last = getattr(daemon, "last_cycle_at", None)
    return {
        "status": "ok" if db_ok else "degraded",
        "models_loaded": getattr(daemon, "models_loaded", False),
        "shutdown": getattr(daemon, "_shutdown", False),
        "cycles_completed": getattr(daemon, "cycles_completed", 0),
        "last_cycle_at": last,
        "seconds_since_last_cycle": round(now - last, 1) if last else None,
        "pending": pending,
    }


def start_health_server(daemon, port=HEALTH_PORT):
    """Start a background HTTP server exposing GET /health. Returns the server."""
    class _Handler(BaseHTTPRequestHandler):
        def do_GET(self):
            if self.path.rstrip("/") in ("/health", ""):
                body = json.dumps(build_health(daemon)).encode()
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
            else:
                self.send_response(404)
                self.end_headers()

        def log_message(self, *args):  # silence per-request stderr noise
            pass

    server = HTTPServer(("127.0.0.1", port), _Handler)
    t = threading.Thread(target=server.serve_forever, daemon=True)
    t.start()
    return server


# --- Helpers ---
def slugify(text, max_len=60):
    name = "".join(c for c in os.path.splitext(text)[0].lower() if c.isalnum() or c in " -_")
    name = "-".join(name.split())
    return name[:max_len].strip("-")


def is_screenshot(path):
    r = subprocess.run(
        ["identify", "-format", "%[exif:Make]|%[exif:Model]|%[exif:UserComment]", str(path)],
        capture_output=True, text=True, timeout=10,
    )
    parts = r.stdout.strip().split("|")
    return not (parts[0] or parts[1] or "Oplus" in parts[2])


def get_file_mtime(path):
    return datetime.fromtimestamp(path.stat().st_mtime, tz=timezone.utc)


# --- Processing ---
class PipelineDaemon:
    def __init__(self):
        self.ocr_reader = None
        self.asr_decoder = None
        self._shutdown = False
        self.models_loaded = False
        self.cycles_completed = 0
        self.last_cycle_at = None

    def load_models(self):
        sys.stderr.write("Loading EasyOCR...\n")
        import easyocr
        self.ocr_reader = easyocr.Reader(["en"], gpu=False)
        sys.stderr.write("Loading Parakeet TDT...\n")
        from asr_decoder import PythonTDTDecoder
        self.asr_decoder = PythonTDTDecoder()
        self.asr_decoder.load(str(MODEL_DIR))
        self.models_loaded = True
        sys.stderr.write("Models loaded.\n")

    def process_screenshot(self):
        row = pop_next("screenshot-ocr")
        if not row:
            return False
        qid, filename = row
        src = SCREENSHOTS_DIR / filename
        if not src.exists():
            mark_done(qid, "missing")
            return True
        if not is_screenshot(src):
            mark_done(qid, "camera")
            return True

        # Per-file timeout (60s) to prevent hanging
        import signal as _sig
        def _timeout_handler(signum, frame):
            raise TimeoutError("screenshot OCR timed out (60s)")
        _sig.signal(_sig.SIGALRM, _timeout_handler)
        _sig.alarm(60)
        try:
            result = self.ocr_reader.readtext(str(src), detail=1, paragraph=False)
        except Exception as e:
            mark_done(qid, "ocr_error", str(e)[:200])
            _sig.alarm(0)
            return True
        _sig.alarm(0)

        text_lines = [item[1] for item in result]
        text = "\n".join(text_lines).strip()
        if not text or len(text) < 5:
            mark_done(qid, "no_text")
            return True

        regions = []
        for item in result:
            bbox, txt, conf = item
            regions.append({
                "text": txt,
                "bbox": [[float(p[0]), float(p[1])] for p in bbox],
                "conf": round(float(conf), 3),
            })

        file_dt = get_file_mtime(src)
        date_str = file_dt.strftime("%m-%d-%y")
        slug = slugify(filename)
        word_count = len(text.split())
        note = SS_KB / f"{slug}.md"
        SS_KB.mkdir(parents=True, exist_ok=True)
        note.write_text(
            f"""---
type: screenshot-ocr
title: "{filename}"
source: OnePlus15 Screenshot
date: {date_str}
ocr_engine: easyocr
word_count: {word_count}
regions: {json.dumps(regions)}
permalink: screenshots/{slug}
---

# {filename}

OCR text extracted on {datetime.now(timezone.utc).strftime('%Y-%m-%d %H:%M UTC')}.

{text}
"""
        )
        mark_done(qid, "done")
        sys.stderr.write(f"[ss] {filename}: ok ({word_count}w, {len(regions)} regions)\n")
        return True

    def process_recording(self):
        row = pop_next("parakeet")
        if not row:
            return False
        qid, filename = row
        src = RECORDINGS_DIR / filename
        if not src.exists():
            mark_done(qid, "missing")
            return True

        # Check if too_large
        dur = None
        r = subprocess.run(
            ["ffprobe", "-v", "error", "-show_entries", "format=duration",
             "-of", "csv=p=0", str(src)],
            capture_output=True, text=True, timeout=15,
        )
        if r.returncode == 0 and r.stdout.strip():
            try:
                dur = float(r.stdout.strip())
            except ValueError:
                pass

        if dur and dur > 3600:  # >1 hour = too_large
            mark_done(qid, "too_large")
            sys.stderr.write(f"[rec] {filename}: {dur/60:.0f}min too large\n")
            return True

        import tempfile, shutil
        with tempfile.TemporaryDirectory() as tmpdir:
            tmp_mp3 = Path(tmpdir) / filename
            wav = Path(tmpdir) / "audio.wav"
            shutil.copy2(src, tmp_mp3)

            conv = subprocess.run(
                ["ffmpeg", "-y", "-err_detect", "ignore_err",
                 "-i", str(tmp_mp3), "-ac", "1", "-ar", "16000", "-f", "wav", str(wav)],
                capture_output=True, timeout=300,
            )
            if conv.returncode != 0 or not wav.exists() or wav.stat().st_size == 0:
                mark_done(qid, "convert_fail", conv.stderr.decode()[-200:])
                return True

            from vad_chunker import split_and_transcribe
            result = split_and_transcribe(str(wav), self.asr_decoder, max_segment_sec=580)
            if not result or not result.get("text", "").strip():
                mark_done(qid, "no_text")
                return True

            text = result["text"].strip()
            slug = slugify(filename)
            date_str = get_file_mtime(src).strftime("%m-%d-%y")
            dur_min = result["audio_duration_ms"] / 60000
            note = REC_KB / f"{slug}.md"
            REC_KB.mkdir(parents=True, exist_ok=True)
            note.write_text(
                f"""---
type: transcript
title: "{filename}"
source: OnePlus15 Recording
date: {date_str}
duration: {dur_min:.1f}min
rtf: {result['rtf']}
tokens: {result['token_count']}
permalink: recordings/{slug}
words: {json.dumps(result.get('words', []))}
---

# {filename}

Transcribed with Parakeet TDT 0.6B v2 (CPU). RTF: {result['rtf']}.

Duration: {dur_min:.1f} minutes. Processing: {result['processing_time_ms']/1000:.1f}s.

{text}
"""
            )
            mark_done(qid, "done")
            sys.stderr.write(f"[rec] {filename}: ok ({result['token_count']}t, rtf={result['rtf']})\n")
        return True

    def cycle(self):
        deadline = time.time() + MAX_RUN_SEC
        # Enqueue any new files
        enqueue_pending("screenshot-ocr", SCREENSHOTS_DIR, ".jpg")
        enqueue_pending("parakeet", RECORDINGS_DIR, ".mp3")

        # Process screenshots in batch (stop promptly on shutdown signal)
        batch = 0
        while batch < SS_BATCH and time.time() < deadline and not self._shutdown:
            if not self.process_screenshot():
                break
            batch += 1

        # Process one recording (skip if shutting down)
        if not self._shutdown:
            self.process_recording()
        self.cycles_completed += 1
        self.last_cycle_at = time.time()

    def run_forever(self):
        # Catch signals for clean shutdown before slow model loading begins.
        signal.signal(signal.SIGTERM, lambda *a: setattr(self, "_shutdown", True))
        signal.signal(signal.SIGINT, lambda *a: setattr(self, "_shutdown", True))

        init_queue()
        # Recover jobs left 'running' by a prior crash/SIGTERM.
        reset = requeue_stale()
        if reset:
            sys.stderr.write(f"Requeued {reset} stale running job(s).\n")

        health = None
        try:
            health = start_health_server(self)
            sys.stderr.write(f"Health endpoint on http://127.0.0.1:{HEALTH_PORT}/health\n")
        except OSError as e:
            sys.stderr.write(f"Health server failed to start: {e}\n")

        self.load_models()

        while not self._shutdown:
            try:
                self.cycle()
            except Exception as e:
                import traceback
                sys.stderr.write(f"cycle error: {e}\n{traceback.format_exc()}\n")
            # Sleep in short slices so SIGTERM is honored within ~1s.
            for _ in range(POLL_INTERVAL):
                if self._shutdown:
                    break
                time.sleep(1)

        # In-flight jobs are still marked 'running'; reset them so the next
        # start re-processes them instead of leaving them stuck.
        requeue_stale()
        if health is not None:
            health.shutdown()
            health.server_close()
        sys.stderr.write("Shutting down.\n")


if __name__ == "__main__":
    daemon = PipelineDaemon()
    daemon.run_forever()
