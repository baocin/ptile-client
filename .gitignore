# Build artifacts
/target/
/cli/target/
/core/target/
/wasm/target/
/ffi/target/
/ffi/target-android/
/ffi/target-apple/
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/coverage/

# wasm-pack output (regenerate via `wasm-pack build wasm --target nodejs --out-dir ../wasm-pkg`)
/wasm-pkg/
/pkg/

# NOT ignored: test-fixtures/ (including test-fixtures/golden/) — golden
# fixtures are checked in so `cargo test --workspace` is reproducible without
# a data-regen step.

# NOT ignored either: conformance/corpus/ — committed slices of real published
# layers. They are what makes `cargo test` and `node --test` pass on a runner
# with no data directory; see conformance/README.md.

# Python bytecode. ffi/bindings/python/__pycache__/ptiles_ffi.cpython-314.pyc
# was committed by accident: CI copies the cdylib next to the generated module
# and imports it, which leaves this behind.
__pycache__/
*.pyc

# Build/tool output that showed up as untracked noise during the address work.
# Wrangler's cache, an ad-hoc archive, and the artifacts/ directory are all
# regenerable; tracking them only makes `git status` unreadable.
.wrangler/
artifacts/
Archive.zip
